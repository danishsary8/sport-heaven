# Copy to .env.local and fill in. Only VITE_* variables are exposed to the browser.

# The API. Leave empty in development (Vite forwards /v1 to http://localhost:3000).
# In production set it to the API origin, e.g. https://api.sportcastle.com.kh
VITE_API_URL=

# Firebase web app config (Firebase console > Project settings > Your apps).
# Without it the shop works for guests and sign-in says it isn't set up yet.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google Maps (the stores map renders only when this is set; otherwise a plain list)
VITE_GOOGLE_MAPS_API_KEY=

# End-to-end tests only: sign in with backend test tokens. NEVER set this for a public build.
VITE_AUTH_TEST_MODE=
